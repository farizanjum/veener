{
	"name": "deocy",
	"version": "1.0.0",
	"description": "Veneer — decoy-text plausible deniability for Obsidian notes",
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"preflight": "node build/obsidian-preflight.mjs",
		"preflight:dist": "node build/obsidian-preflight.mjs --require-dist",
		"package:release": "node build/package-release.mjs",
		"smoke:site": "node build/site-smoke-check.mjs"
	},
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.1",
		"@types/node": "^22.10.2",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.2",
		"obsidian": "^1.7.2",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	},
	"dependencies": {
		"@wllama/wllama": "^3.5.1",
		"hash-wasm": "^4.12.0"
	}
}
